+typedef struct { uint64_t cost; int offset; } EPCost;
+static int ep_cost_order(const void* av, const void* bv) {
+    const EPCost* a = (const EPCost*)av; const EPCost* b = (const EPCost*)bv;
+    if (a->cost != b->cost) return a->cost > b->cost ? -1 : 1;
+    return a->offset - b->offset;
+}
+static uint64_t ep_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec*1000000000ull+t.tv_nsec; }
 
