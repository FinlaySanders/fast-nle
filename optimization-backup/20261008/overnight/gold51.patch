+        if (check)
+            panic("stale hero gold absence");
+#endif
+        return (struct obj *) 0;
+    }
     while (chain && chain->otyp != GOLD_PIECE)
         chain = chain->nobj;
+    if (hero_chain && nh_gold_absence && !chain)
+        nh_gold_absence = 2;
     return chain;
 }
 
