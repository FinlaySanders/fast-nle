+nle_copy_glyph_rows(short *dst, unsigned mask)
+{
+    int y;
+    for (y = 0; y < ROWNO; y++)
+        if (mask & (1u << y))
+            memcpy(dst + (size_t) y * (COLNO - 1), &gbuf_glyph[y][1],
+                   (COLNO - 1) * sizeof(*dst));
+}
+
+/* Rows with show_glyph() writes not yet flushed to the window port. */
+unsigned
+nle_gbuf_pending_rows()
+{
+    unsigned m = 0;
+    int y;
+    for (y = 0; y < ROWNO; y++)
+        if (gbuf_start[y] <= gbuf_stop[y])
+            m |= 1u << y;
+    return m;
+}
